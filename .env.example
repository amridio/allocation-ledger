# Copy to .env and adjust. Used by docker-compose and the app.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=allocation_ledger
POSTGRES_TEST_DB=ops_test
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/allocation_ledger
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ops_test

# Max Postgres connections ONE app instance may hold (default 10). See the README before raising it.
DATABASE_POOL_SIZE=10
