# Copy to .env and adjust. Used by docker-compose and the app.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=allocation_ledger
POSTGRES_TEST_DB=ops_test
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/allocation_ledger
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ops_test

# Max Postgres connections ONE app instance may hold (default 10). See the README before raising it.
DATABASE_POOL_SIZE=10

# TEMPORARY login: lets anyone pick any user (screen + POST /api/switch-user). Anything other than "true" = off.
# Keep it off (the default when unset) anywhere real data lives.
ENABLE_USER_SWITCHER=true

# How often (ms) the open screen polls while visible. Hidden tabs poll every 30 s.
UI_POLL_MS=3000

# Time zone the screen shows times in (an IANA name). Server and browser must agree, so it is fixed, not "whatever the device says".
APP_TIMEZONE=UTC
