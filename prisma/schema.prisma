generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OPERATOR
  SUPERVISOR
}

enum EntryKind {
  ALLOCATION
  ADJUSTMENT
}

// Operator tier. Controls how long an allocation lasts (null = never expires).
// Lives in the database so it can change without a deploy.
model Tier {
  id            String     @id @default(cuid())
  name          String     @unique
  expiryMinutes Int?       @map("expiry_minutes")
  operators     Operator[]

  @@map("tier")
}

// A shared unit pool.
//
// `balance` is a CACHE of the sum of ALL ledger units for this pool, expired or not
// (a lifetime net total, useful for reconciliation). It must only change in the same
// transaction that inserts a ledger row, under SELECT ... FOR UPDATE on this row.
// Never read-modify-write it from app code.
//
// `capacity` (null = no limit) is measured in ACTIVE units, the same measure operator
// status uses: units whose expiresAt is null or in the future. An expired allocation no
// longer holds anything, so it does not count against capacity. DECISION: the capacity
// check must NOT use `balance`.
//   - Active units are computed from the ledger at insert time: SUM(units) for this pool
//     WHERE expiresAt IS NULL OR expiresAt > now, with `now` injected.
//   - Run the check inside the same transaction, after taking the pool row lock, so
//     concurrent writers are serialized.
//   - Expiry only ever lowers active units, so a concurrent expiry can free capacity
//     but never use it up: the check cannot be wrong in the unsafe direction.
//   - There is deliberately no cached "active balance": expiry happens with the passage
//     of time, not through a write, so nothing would keep it current.
// What happens when a new allocation would exceed capacity (reject or warn) is a
// domain/product decision and is not made here.
model Pool {
  id        String        @id @default(cuid())
  name      String        @unique
  capacity  Int?
  balance   Int           @default(0)
  updatedAt DateTime      @updatedAt @map("updated_at")
  operators Operator[]
  entries   LedgerEntry[]

  @@map("pool")
}

model Operator {
  id     String @id @default(cuid())
  name   String
  role   Role   @default(OPERATOR)
  tierId String @map("tier_id")
  poolId String @map("pool_id")
  tier   Tier   @relation(fields: [tierId], references: [id])
  pool   Pool   @relation(fields: [poolId], references: [id])

  // Entries about this operator / entries this operator recorded (supervisors record adjustments).
  entries  LedgerEntry[] @relation("EntryOperator")
  recorded LedgerEntry[] @relation("EntryCreator")

  // Target of the composite FK from LedgerEntry, which keeps entry.pool_id equal to operator.pool_id.
  @@unique([id, poolId])
  @@map("operator")
}

// APPEND-ONLY. A database trigger rejects UPDATE, DELETE and TRUNCATE (see migrations).
// An adjustment is a new row (kind = ADJUSTMENT) whose refSeq points at the entry it adjusts.
model LedgerEntry {
  seq            Int       @id @default(autoincrement())
  kind           EntryKind
  operatorId     String    @map("operator_id")
  poolId         String    @map("pool_id")
  createdById    String    @map("created_by_id")
  // Signed: allocations positive, adjustments may be negative. Never 0 (CHECK in migration).
  units          Int
  // When it happened in the field. May be earlier than recordedAt (flaky connections).
  effectiveAt    DateTime  @map("effective_at")
  // When the server recorded it.
  recordedAt     DateTime  @default(now()) @map("recorded_at")
  // Calculated once at creation from the operator's tier at that time; never recomputed. null = never.
  expiresAt      DateTime? @map("expires_at")
  // ADJUSTMENT only: the entry being adjusted.
  refSeq         Int?      @map("ref_seq")
  // Required for ADJUSTMENT (CHECK in migration).
  reason         String?
  // Client-generated; unique per creator so one client's retries can't collide with another's.
  idempotencyKey String    @map("idempotency_key")

  operator   Operator      @relation("EntryOperator", fields: [operatorId, poolId], references: [id, poolId])
  pool       Pool          @relation(fields: [poolId], references: [id])
  createdBy  Operator      @relation("EntryCreator", fields: [createdById], references: [id])
  ref        LedgerEntry?  @relation("Adjustments", fields: [refSeq], references: [seq], onDelete: Restrict)
  adjustedBy LedgerEntry[] @relation("Adjustments")

  @@unique([createdById, idempotencyKey])
  // Per-operator history, newest first / date range. seq breaks ties on equal effectiveAt.
  @@index([operatorId, effectiveAt, seq])
  // Pool feed and "everything after seq N" cursors.
  @@index([poolId, seq])
  // "What adjusted this entry?"
  @@index([refSeq])
  @@map("ledger_entry")
}
